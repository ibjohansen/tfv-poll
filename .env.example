# Copy this file to .env.local for local development.
# Get the connection string from Neon -> Project -> Connect.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Direct (non-pooler) URL. Required for schema migrations and member imports.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Neon Object Storage. Opprettes med `neon deploy` og hentes med
# `neon env pull`. Verdiene skal bare være tilgjengelige på serveren.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=eu-central-1
# Netlify reserverer AWS-navnene over. Bruk de samme verdiene under disse
# navnene i Netlify (de er ikke nødvendige i lokal .env.local):
# NEON_STORAGE_ACCESS_KEY_ID=
# NEON_STORAGE_SECRET_ACCESS_KEY=
# NEON_STORAGE_ENDPOINT=
# NEON_STORAGE_REGION=eu-central-1

# Local development only; ignored in production. No database needed.
MOCK_DATA=true

# Microsoft Entra ID: single-tenant app registration (server-side only).
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Canonical app URL, e.g. http://localhost:3000 or production HTTPS URL.
AUTH_URL=http://localhost:3000
# Optional comma-separated restriction. Empty permits the configured tenant's
# accounts on @turufjellvel.no.
ADMIN_EMAILS=

# Kartverkets Matrikkel-API. Kun tilgjengelig server-side.
API_MATRIKKEL_BASE_URL=https://matrikkel.no/matrikkelapi/wsapi/v1
API_MATRIKKEL_USR=
# I .env.local må hvert $-tegn i passordet skrives som \$ fordi Next.js
# ellers forsøker å ekspandere resten som navnet på en miljøvariabel.
API_MATRIKKEL_PWD=
# Egen rolle for å starte og følge matrikkelsynkronisering. Ingen får rollen
# dersom variabelen mangler eller er tom.
MATRIKKEL_SYNC_EMAILS=ib@turufjellvel.no
# Tilfeldig intern hemmelighet mellom Next.js og Netlifys bakgrunnsfunksjon.
MATRIKKEL_JOB_SECRET=
# Skal bare settes lokalt når Kartverkets testmiljø brukes bevisst.
MATRIKKEL_ALLOW_PRODTEST=false

# MailerSend Email API. Alt er server-side; aldri bruk NEXT_PUBLIC_-prefiks.
# Sending er av som standard, slik at lokal testing ikke sender e-post.
MAILERSEND_ENABLED=false
# Holdes false til styret eksplisitt har godkjent masseutsendelse.
MAILERSEND_BULK_ENABLED=false
MAILERSEND_API_TOKEN=
# Må være en reell adresse på det verifiserte domenet turufjellvel.no.
MAILERSEND_FROM_EMAIL=post@turufjellvel.no
MAILERSEND_FROM_NAME="Turufjell Vel"
MAILERSEND_REPLY_TO_EMAIL=post@turufjellvel.no
MAILERSEND_DOMAIN_ID=
# Hentes fra webhooken i MailerSend etter at den er opprettet.
MAILERSEND_WEBHOOK_SIGNING_SECRET=
# Tilfeldig intern hemmelighet mellom Next.js og Netlify-funksjonen.
MAILERSEND_JOB_SECRET=
