{
  "name": "turufjell-medlemsservice",
  "description": "Medlemsadministrasjon, undersøkelser og registerkontroll for Turufjell Vel.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibjohansen/tfv-poll.git"
  },
  "license": "UNLICENSED",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && npm run build",
    "db:setup": "node --use-system-ca --env-file=.env.local scripts/setup-database.mjs",
    "db:security-cleanup": "node --use-system-ca --env-file=.env.local scripts/security-cleanup.mjs",
    "members:import": "node --use-system-ca --env-file=.env.local scripts/import-members.mjs",
    "test": "node --experimental-vm-modules --test tests/*.test.mjs",
    "test:integration": "node --experimental-vm-modules --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@material-tailwind/react": "^3.0.0-beta.24",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@neondatabase/serverless": "^1.0.0",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@turf/turf": "^7.4.0",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.1",
    "leaflet": "^1.9.4",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "proj4": "^2.22.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
