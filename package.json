    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@material-tailwind/react": "^3.0.0-beta.24",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@neondatabase/serverless": "^1.0.0",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.1",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
