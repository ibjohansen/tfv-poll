{
  "name": "turufjell-medlemsservice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && npm run build",
    "db:setup": "node --use-system-ca --env-file=.env.local scripts/setup-database.mjs",
